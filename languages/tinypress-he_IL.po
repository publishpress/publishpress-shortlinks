#: includes/functions.php:301
msgid "Copy shortlink"
msgstr "העתק קישור קצר"

#: includes/functions.php:318
msgid "Shortlink slug"
msgstr "סלוגן קישור קצר"

#: includes/functions.php:321
#: includes/functions.php:324
msgid "Enter a shortlink slug."
msgstr "הזן סלוגן לקישור קצר."

#: includes/functions.php:573
msgid "The Shortlink exists but metadata authorization prevented setup."
msgstr "הקישור הקצר קיים אך הרשאת המטא מנעה הקמה."

#: includes/Mcp/Actions.php:22
msgid "Find Shortlink categories"
msgstr "מצא קטגוריות קישורים קצרים"

#: includes/Mcp/Actions.php:22
msgid "List native link categories with their current revision."
msgstr "רשום קטגוריות קישורים מקומיות עם הגרסה הנוכחית שלהן."

#: includes/Mcp/Actions.php:23
msgid "Create or update a Shortlink category"
msgstr "צור או עדכן קטגוריית קישור קצר"

#: includes/Mcp/Actions.php:23
msgid ""
"Use native taxonomy controls and permissions. Read expected_hash from "
"list-categories before editing; omitted fields are preserved."
msgstr ""
"השתמש בבקרות והרשאות קטגוריות מקומיות. קרא expected_hash מרשימת הקטגוריות "
"לפני עריכה; שדות המושמטות נשמרים."

#: includes/Mcp/Actions.php:24
msgid "Set Shortlink categories"
msgstr "קבע קטגוריות קישור קצר"

#: includes/Mcp/Actions.php:24
msgid ""
"Replace native category assignments with an explicit integer list. [] "
"clears assignments; use the current get-link revision."
msgstr ""
"החלף הקצאות קטגוריה מקומיות עם רשימת מספרים מפורשת. [] מנקה הקצאות; השתמש "
"בגרסה הנוכחית של get-link."

#: includes/Mcp/Actions.php:25
msgid "Set my Shortlink favorite"
msgstr "הגדר את המועדף של הקישור הקצר שלי"

#: includes/Mcp/Actions.php:25
msgid ""
"Set favorite true or false for the connected user only. Read the current "
"get-link revision first."
msgstr ""
"הגדר מועדף נכון או שקר עבור המשתמש המחובר בלבד. קרא קודם את גרסת הקישור "
"הנוכחית."

#: includes/Mcp/Actions.php:27
msgid "Update multiple Shortlinks"
msgstr "עדכן מספר קישורים קצרים"

#: includes/Mcp/Actions.php:27
msgid ""
"Preflight up to 20 existing links before any writes. Linked source targets "
"must not overlap. Each item uses the original get-link revision. Native "
"writes are not transactional: inspect complete, applied_ids and failed_id. "
"dry_run previews all items."
msgstr ""
"בצע בדיקות לפני עדכון עד 20 קישורים קיימים לפני כל כתיבה. מטרות המקור "
"הקשורות אינן יכולות לחפוף. כל פריט משתמש בגרסת הקישור המקורי. כתיבות "
"מקומיות אינן טרנזקציוניות: בדוק את ה-complete, applied_ids ו-failed_id. "
"dry_run מציג את כל הפריטים."

#: includes/Mcp/Actions.php:28
msgid "Delete a Shortlink category"
msgstr "מחק קטגוריית קישור קצר"

#: includes/Mcp/Actions.php:28
msgid ""
"Delete a native category without deleting its links. Authorize every "
"affected link and child category; read the current category revision first."
msgstr ""
"מחק קטגוריה מקומית מבלי למחוק את הקישורים שלה. אשר כל קישור וקטגוריה בתוכה; "
"קרא קודם את גרסת הקטגוריה הנוכחית."

#: includes/Mcp/Actions.php:29
msgid "Read Shortlink click counts"
msgstr "קרא את מספרי הלחיצות על קישור קצר"

#: includes/Mcp/Actions.php:29
msgid ""
"Read native daily chart counts and reset revision for one readable link. "
"Visitor IPs, user identifiers, referrers and raw request logs are excluded."
msgstr ""
"קרא את מספרי התרשימים היומיים המקומיים ואפס גרסה עבור קישור קריא אחד. "
"כתובות ה-IP של המבקרים, מזהי המשתמשים, מפנים ויומני בקשות גולמיים מוצהרים."

#: includes/Mcp/Actions.php:30
msgid "Reset Shortlink chart counts"
msgstr "אפס את מספרי התרשימים של הקישור הקצר"

#: includes/Mcp/Actions.php:30
msgid ""
"Mark this link analytics cleared through the native reset service. Audit "
"logs remain. Requires current analytics expected_hash, analytics and object "
"edit permissions. dry_run previews."
msgstr ""
"סמן את האנליטיקות של קישור זה כאילו נמחקו על ידי שירות האיפוס המקומי. יומני "
"הביקורת נשמרים. דורש hash צפוי נוכחי לאנליטיקות, אנליטיקות והרשאות עריכה של "
"אובייקטים. dry_run מציג."

#: includes/Mcp/Actions.php:32
msgid "Read saved Shortlink health"
msgstr "קרא את בריאות הקישור הקצר ששמרת"

#: includes/Mcp/Actions.php:32
msgid ""
"Read the native Pro health status and response code for one readable link. "
"Does not perform HTTP requests."
msgstr ""
"קרא את מצב הבריאות והקוד של ה-Pro המקומי עבור קישור קריא אחד. לא מבצע בקשות "
"HTTP."

#: includes/Mcp/Actions.php:33
msgid "Check Shortlink health"
msgstr "בדוק את בריאות הקישור הקצר"

#: includes/Mcp/Actions.php:33
msgid ""
"Run the active native Pro link checker for an editable link and store its "
"result. Native URL safety and type settings apply. Requires current "
"get-link expected_hash. dry_run does not request destinations."
msgstr ""
"הרץ את בודק הקישורים הפעיל המקומי עבור קישור שניתן לעריכה ושמור את התוצאה "
"שלו. הגדרות הבטיחות והסוג של כתובת ה-URL המקומית חלות. דורש hash צפוי נוכחי "
"של הקישור. dry_run לא מבקש יעדים."

#: includes/Mcp/Actions.php:35
msgid "Read a post Shortlink"
msgstr "קרא קישור קצר לפוסט"

#: includes/Mcp/Actions.php:35
msgid ""
"Read the native editor Short String for an enabled post type without "
"generating a URL or changing metadata."
msgstr ""
"קרא את המחרוזת הקצרה המקומית של העורך עבור סוג פוסט מופעל מבלי ליצור URL או "
"לשנות מטא דטה."

#: includes/Mcp/Actions.php:36
msgid "Set a post Short String"
msgstr "הגדר מחרוזת קצרה לפוסט"

#: includes/Mcp/Actions.php:36
msgid ""
"Update an enabled post native Short String, preserving other metabox "
"values. All auto-listed mirror links need permission and are included in "
"the revision. dry_run previews."
msgstr ""
"עדכן את המחרוזת הקצרה המקומית של הפוסט המופעל, שומר על ערכים אחרים של תיבת "
"המטא. כל הקישורים המוצגים אוטומטית צריכים אישור והם כלולים בגרסה. dry_run "
"מציג."

#: includes/Mcp/Actions.php:37
msgid "Set Shortlink publication status"
msgstr "הגדר את מצב הפרסום של הקישור הקצר"

#: includes/Mcp/Actions.php:37
msgid ""
"Change a native link to publish, draft, pending or private with the current "
"revision and native publication permissions. Source-linked records retain "
"their native source lifecycle."
msgstr ""
"שנה קישור מקומי לפרסם, טיוטה, ממתין או פרטי עם הגרסה הנוכחית והרשאות הפרסום "
"המקומיות. רשומות מקושרות למקור שומרות על מחזור חיי המקור המקומי שלהן."

#: includes/Mcp/Actions.php:38
msgid "Duplicate a Shortlink to a draft"
msgstr "שכפל קישור קצר לטיוטה"

#: includes/Mcp/Actions.php:38
msgid ""
"Use the native Duplicate service with a new Short String and the connected "
"user as author. Requires source edit/read, category assignment and create "
"permissions. No password values are returned. dry_run previews without "
"creating a draft."
msgstr ""
"השתמש בשירות השכפול המקומי עם מחרוזת קצרה חדשה והמשתמש המחובר ככותב. דורש "
"הרשאות עריכה/קריאה של המקור, הקצאת קטגוריה והרשאות יצירה. אין ערכי סיסמאות "
"המוחזרים. dry_run מציג מבלי ליצור טיוטה."

#: includes/Mcp/Actions.php:40
msgid "Clear the native autolink cache"
msgstr "נקה את מטמון הקישור האוטומטי המקומי"

#: includes/Mcp/Actions.php:40
msgid ""
"Invalidate native Pro autolink rules without changing links or settings. "
"Requires native manage_options and Shortlinks settings permission. dry_run "
"previews."
msgstr ""
"בטל את תקפות הכללים האוטומטיים המקומיים מבלי לשנות קישורים או הגדרות. דורש "
"הרשאות ניהול אפשרויות מקומיות והגדרות קישורים קצרים. dry_run מציג."

#: includes/Mcp/Actions.php:46
msgid "Read a Shortlinks report summary"
msgstr "קרא סיכום דוח קישורים קצרים"

#: includes/Mcp/Actions.php:46
msgid ""
"Read native Pro totals, distinct visitor counts and averages for up to 20 "
"explicit readable links between start_date and end_date (YYYY-MM-DD). No "
"IPs, account IDs, referrers or request URLs are returned. Native report "
"totals include retained logs after chart resets."
msgstr ""
"קרא את הסכומים המקומיים, מספרי המבקרים הייחודיים והממוצעים עבור עד 20 "
"קישורים קריאים מפורשים בין start_date ל-end_date (YYYY-MM-DD). אין כתובות "
"IP, מזהי חשבונות, מפנים או כתובות בקשות מוחזרות. סכומי הדוח המקומיים כוללים "
"יומנים שנשמרו לאחר איפוס התרשימים."

#: includes/Mcp/Actions.php:50
msgid "Read Shortlinks settings"
msgstr "קרא את הגדרות הקישורים הקצרים"

#: includes/Mcp/Actions.php:50
msgid ""
"Discover exact native settings, choices and defaults. Passwords, license "
"data and unsupported native controls are excluded. Booleans are JSON "
"booleans, IDs integers, selections strings and lists arrays."
msgstr ""
"גלה הגדרות מקומיות מדויקות, בחירות ודפוסים. סיסמאות, נתוני רישוי ובקרות "
"מקומיות שאינן נתמכות הוצאו. בוליאנים הם בוליאנים JSON, מזהים הם שלמים, "
"בחירות הן מחרוזות ורשימות הן מערכים."

#: includes/Mcp/Actions.php:51
msgid "Update Shortlinks settings"
msgstr "עדכן את הגדרות הקישורים הקצרים"

#: includes/Mcp/Actions.php:51
msgid ""
"Patch discovered fields using their exact schemas and current "
"expected_hash. Omitted settings and secrets remain unchanged. dry_run "
"previews native sanitized values."
msgstr ""
"תקן שדות שנמצאו באמצעות הסכמות המדויקות שלהם ו-hash צפוי נוכחי. הגדרות "
"וסודות שהושמטו נשארים ללא שינוי. dry_run מציג ערכים מקומיים מחוטאים."

#: includes/Mcp/Actions.php:52
msgid "Find Shortlinks"
msgstr "מצא קישורים קצרים"

#: includes/Mcp/Actions.php:52
msgid ""
"List readable Shortlinks by title or status. Returns IDs and labels only; "
"use get-link to inspect configuration."
msgstr ""
"רשום קישורים קצרים קריאים לפי כותרת או מצב. מחזיר מזהים ותוויות בלבד; השתמש "
"בקישור כדי לבדוק את ההגדרה."

#: includes/Mcp/Actions.php:53
msgid "Read a Shortlink"
msgstr "קרא קישור קצר"

#: includes/Mcp/Actions.php:53
msgid ""
"Read native per-link fields and current expected_hash; omit id to discover "
"defaults. No link passwords, raw visitor IPs or user-agent logs are "
"returned."
msgstr ""
"קרא שדות לקישור המקומי הנוכחי וה-hash הצפוי; השמט id כדי לגלות דפוסים. אין "
"ערכי סיסמאות לקישור, כתובות IP גולמיות של מבקרים או יומני משתמש מוחזרים."

#: includes/Mcp/Actions.php:54
msgid "Create or update a Shortlink"
msgstr "צור או עדכן קישור קצר"

#: includes/Mcp/Actions.php:54
msgid ""
"Create a published Shortlink with target_url and label, or patch id with "
"current expected_hash. Native redirect, expiration, autolink and active Pro "
"controls use discovered fields. All related source posts must be editable. "
"dry_run previews. No destination URLs are fetched."
msgstr ""
"צור קישור קצר שפורסם עם target_url ותווית, או תקן id עם hash צפוי נוכחי. "
"הפניות מקומיות, תאריך תפוגה, קישור אוטומטי ובקרות Pro פעילות משתמשות בשדות "
"שנמצאו. כל הפוסטים המקוריים הקשורים חייבים להיות ניתנים לעריכה. dry_run "
"מציג. אין כתובות URL יעד שנמשכות."

#: includes/Mcp/Actions.php:55
msgid "Trash, restore or delete a Shortlink"
msgstr "אחסן, שחזר או מחק קישור קצר"

#: includes/Mcp/Actions.php:55
msgid ""
"Native Shortlink lifecycle; permanent deletion requires prior trash. "
"Requires current expected_hash and native deletion permission. dry_run "
"previews."
msgstr ""
"מחזור חיי הקישור הקצר המקומי; מחיקה קבועה דורשת אחסון קודם. דורש hash צפוי "
"נוכחי והרשאת מחיקה מקומית. dry_run מציג."

#: includes/Mcp/Actions.php:140
msgid "Narrow the search or use native administration for more than 1,000 links."
msgstr "צמצם את החיפוש או השתמש בניהול מקומי עבור יותר מ-1,000 קישורים."

#: includes/Mcp/Actions.php:173
msgid "Revision destinations and routing follow the native revision workflow."
msgstr "יעדים של גרסה וניווט עוקבים אחרי מהלך העבודה של גרסה המקומית."

#: includes/Mcp/Actions.php:176
msgid "Supply target_url for a new Shortlink."
msgstr "ספק target_url עבור Shortlink חדש."

#: includes/Mcp/Actions.php:187
msgid "Use a nonempty short path with letters, numbers, dashes or underscores."
msgstr "השתמש בדרך קצרה שאינה ריקה עם אותיות, מספרים, מקפים או קווים תחתונים."

#: includes/Mcp/Actions.php:193
msgid "The short path is unavailable."
msgstr "הדרך הקצרה אינה זמינה."

#: includes/Mcp/Actions.php:200
msgid "This label choice is not available for the destination."
msgstr "בחירה זו בלבול אינה זמינה עבור היעד."

#: includes/Mcp/Actions.php:244
msgid "The post exists but metadata permissions changed. Read before retrying."
msgstr "הפוסט קיים אך הרשאות המטא-דאטה השתנו. קרא לפני שניסית שוב."

#: includes/Mcp/Actions.php:270
msgid "Manage linked source records in native administration."
msgstr "נהל רשומות מקור מקושרות בניהול מקורי."

#: includes/Mcp/Actions.php:275
msgid "Read the current lifecycle state first."
msgstr "קרא את מצב מחזור החיים הנוכחי קודם."

#: includes/Mcp/Actions.php:311
msgid "Unknown Shortlink category."
msgstr "קטגוריית Shortlink לא ידועה."

#: includes/Mcp/Actions.php:317
msgid "Supply a category name."
msgstr "ספק שם קטגוריה."

#: includes/Mcp/Actions.php:320
msgid "Use an existing parent without a cycle."
msgstr "השתמש בהורה קיים ללא מחזור."

#: includes/Mcp/Actions.php:385
msgid "Bulk short paths must be unique."
msgstr "דרכים קצרות בכמות חייבות להיות ייחודיות."

#: includes/Mcp/Actions.php:392
msgid "Bulk targets and linked source records must not overlap."
msgstr "יעדים בכמות ורשומות מקור מקושרות אינן יכולות לחפוף."

#: includes/Mcp/Actions.php:431
msgid "Use native administration for this category scope."
msgstr "השתמש בניהול מקורי עבור טווח קטגוריה זה."

#: includes/Mcp/Actions.php:463
msgid "Use native analytics for more than 1,000 daily records."
msgstr "השתמש בניתוח מקורי עבור יותר מ-1,000 רשומות יומיות."

#: includes/Mcp/Actions.php:477
msgid "Use native analytics for this destination scope."
msgstr "השתמש בניתוח מקורי עבור טווח יעד זה."

#: includes/Mcp/Actions.php:492
msgid "Analytics changed; read it again before resetting."
msgstr "האנליטיקה השתנתה; קרא שוב לפני האיפוס."

#: includes/Mcp/Actions.php:523
msgid "This link type is disabled in native Link Health settings."
msgstr "סוג הקישור הזה מנוטרל בהגדרות בריאות הקישור המקורי."

#: includes/Mcp/Actions.php:556
msgid "Native source mirrors could not be safely read."
msgstr "מראות מקור מקורי לא ניתן לקרוא בבטחה."

#: includes/Mcp/Actions.php:586
msgid "The source or a mirror changed; read it again."
msgstr "המקור או מראה השתנה; קרא שוב."

#: includes/Mcp/Actions.php:598
msgid "Use a nonempty short path."
msgstr "השתמש בדרך קצרה שאינה ריקה."

#: includes/Mcp/Actions.php:604
msgid "This short path is unavailable."
msgstr "הדרך הקצרה הזו אינה זמינה."

#: includes/Mcp/Actions.php:625
msgid "Duplicate revision-linked records through the native revision workflow."
msgstr "שכפל רשומות מקושרות לגרסה דרך זרימת העבודה של גרסה המקורית."

#: includes/Mcp/Actions.php:711
msgid "Use valid native report dates in YYYY-MM-DD format."
msgstr "השתמש בתאריכים מדויקים בדו\"ח בפורמט YYYY-MM-DD."

#: includes/Mcp/Actions.php:715
msgid "The report end date must not precede its start."
msgstr "תאריך הסיום של הדו\"ח אינו יכול להקדים את תחילתו."

#: includes/Mcp/Actions.php:724
msgid "Native report data could not be read."
msgstr "נתוני הדו\"ח המקורי לא ניתן לקרוא."

#: includes/Mcp/bootstrap.php:15
msgid "PublishPress plugin actions."
msgstr "פעולות תוסף PublishPress."

#: includes/Mcp/Fields.php:178
msgid "Supply each native list identifier only once."
msgstr "ספק כל מזהה רשימה מקורי רק פעם אחת."

#: includes/Mcp/Fields.php:191
msgid "Use the native date or time format returned by discovery."
